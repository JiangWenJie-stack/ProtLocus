{% set version = "__VERSION__" %}

package:
  name: protlocus-gpu
  version: {{ version }}

source:
  url: https://github.com/__REPOSITORY__/releases/download/v{{ version }}/protlocus-{{ version }}.tar.gz
  sha256: __SHA256__

build:
  number: 2
  skip: true  # [not linux or not x86_64]

requirements:
  build:
    - {{ compiler('c') }}
    - {{ stdlib('c') }}
    - make
  host:
    - zlib
    - ocl-icd
  run:
    - protlocus =={{ version }}
    - zlib
    - ocl-icd
    - python >=3.9
    - bash
    - time

test:
  source_files:
    - test/DPP3-hs.gen.fa.gz
    - test/DPP3-mm.pep.fa.gz
  commands:
    - protlocus-gpu --version
    - protlocus-gpu --help

about:
  home: https://github.com/__REPOSITORY__
  license: MIT
  license_file: LICENSE.txt
  summary: OpenCL backend for ProtLocus, with a separate executable.
  dev_url: https://github.com/__REPOSITORY__

extra:
  recipe-maintainers:
    - __MAINTAINER__
